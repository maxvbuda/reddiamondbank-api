# Copy to .env for local development. On Render, set these in the dashboard.

# Your MongoDB connection string (e.g. from MongoDB Atlas).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/reddiamondbank?retryWrites=true&w=majority

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Port (Render sets this automatically; default 3000 locally).
PORT=3000
